<Project Sdk="Microsoft.NET.Sdk">
  <!-- Off-MultiCharts tests for the GX engine inside _GenericExit.Strategy.CS (specs/generic-exit-manager-spec.md rev 1.1 §8.3). Not part of PLStudies.csproj. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DefineConstants>GX_OFFMC</DefineConstants>
    <NoWarn>CS0642;CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Generated\**" />
    <Compile Include="..\..\_GenericExit.Strategy.CS" Link="Linked\_GenericExit.cs" />
  </ItemGroup>
</Project>
