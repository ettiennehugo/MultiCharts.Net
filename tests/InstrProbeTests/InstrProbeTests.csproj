<Project Sdk="Microsoft.NET.Sdk">
  <!-- Off-MultiCharts tests for the M-INSTR PR-I0 probe helpers (specs/instrument-profile-spec.md rev 3 §12). gen.sh extracts the
       MC-free <instr-probe-core> region of _InstrProbeCore.Function.CS into Generated/ before building. Not part of PLStudies.csproj. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Generated\**" />
  </ItemGroup>
  <Target Name="GenerateExtracted" BeforeTargets="BeforeBuild">
    <Exec Command="bash gen.sh" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Compile Include="Generated\*.cs" />
    </ItemGroup>
  </Target>
</Project>
