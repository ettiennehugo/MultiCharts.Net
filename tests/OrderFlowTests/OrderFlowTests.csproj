<Project Sdk="Microsoft.NET.Sdk">
  <!-- Off-MultiCharts acceptance tests T1-T8 for the VPF-5 (spec Rev 2.5) order-flow engine. run.sh extracts the MC-free <order-flow> block of
       _OrderFlow.Function.CS into Generated/ before building. Not part of PLStudies.csproj. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Generated\**" />
  </ItemGroup>
  <!-- Extracts MC-free regions of the study files into Generated/ before each build (needs bash: Git Bash/WSL on Windows). -->
  <Target Name="GenerateExtracted" BeforeTargets="BeforeBuild">
    <Exec Command="bash gen.sh" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Compile Include="Generated\*.cs" />
    </ItemGroup>
  </Target>
</Project>
