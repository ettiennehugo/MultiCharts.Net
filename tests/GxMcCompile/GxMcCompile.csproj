<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the GX wrapper and the sandbox test host with GX_OFFMC off, against minimal MC stubs.
       Not part of PLStudies.csproj. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Generated\**" />
    <Compile Include="..\..\_GenericExit.Strategy.CS" Link="Linked\_GenericExit.cs" />
    <Compile Include="..\..\_PortMM.Function.CS" Link="Linked\_PortMM.cs" />
    <Compile Include="Generated\Host.cs" Link="Linked\Host.cs" />
  </ItemGroup>
</Project>
