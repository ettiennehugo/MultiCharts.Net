<Project Sdk="Microsoft.NET.Sdk">
  <!-- Off-MultiCharts tests for the A2-63 host core + G-R regime gate (_RegimeGate, specs/regime-consumer-prereg.md). Not part of
       PLStudies.csproj. _RegimeGate and _RegimeEngine are MC-free, so the real sources are linked as is. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0642;CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\_RegimeGate.Function.CS" Link="Linked\_RegimeGate.cs" />
    <Compile Include="..\..\_RegimeEngine.Function.CS" Link="Linked\_RegimeEngine.cs" />
    <Compile Include="..\..\_Gmm.Function.CS" Link="Linked\_Gmm.cs" />
    <Compile Include="..\..\_Rng.Function.CS" Link="Linked\_Rng.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Generated\**" />
  </ItemGroup>
  <!-- Extracts the MC-free CME calendar rules into Generated/ before each build (needs bash: Git Bash/WSL on Windows). -->
  <Target Name="GenerateExtracted" BeforeTargets="BeforeBuild">
    <Exec Command="bash gen.sh" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Compile Include="Generated\*.cs" />
    </ItemGroup>
  </Target>
</Project>
