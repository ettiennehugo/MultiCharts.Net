<Project Sdk="Microsoft.NET.Sdk">
  <!-- Off-MultiCharts tests for _AvwapManager (spec missing-functionality §2). run.sh copies the MC-free helper file into Generated/. Not part of PLStudies.csproj. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0642;CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Generated\**" />
    <Compile Include="..\..\_AvwapManager.Function.CS" Link="Linked\_AvwapManager.cs" />
    <Compile Include="..\..\_Rng.Function.CS" Link="Linked\_Rng.cs" />
  </ItemGroup>
</Project>
