<Project Sdk="Microsoft.NET.Sdk">
  <!-- Off-MultiCharts tests for _PortMM (specs/m-port-spec.md). Not part of PLStudies.csproj. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <NoWarn>CS0642;CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- The PowerLanguage editor references Newtonsoft.Json; the tests use the real parser. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Generated\**" />
    <Compile Include="..\..\_PortMM.Function.CS" Link="Linked\_PortMM.cs" />
  </ItemGroup>
</Project>
