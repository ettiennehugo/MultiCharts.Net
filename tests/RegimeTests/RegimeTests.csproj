<Project Sdk="Microsoft.NET.Sdk">
  <!-- Off-MultiCharts tests for the G-R regime engine (_RegimeEngine, Phase 3 §3.3). Not part of PLStudies.csproj.
       _RegimeEngine is MC-free, so the real sources are linked as is (no extraction step / gen.sh needed). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0642;CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="gv\**" />
    <Compile Include="..\..\_RegimeEngine.Function.CS" Link="Linked\_RegimeEngine.cs" />
    <Compile Include="..\..\_Gmm.Function.CS" Link="Linked\_Gmm.cs" />
    <Compile Include="..\..\_Rng.Function.CS" Link="Linked\_Rng.cs" />
  </ItemGroup>
</Project>
