<Project Sdk="Microsoft.NET.Sdk">
  <!-- Off-MultiCharts tests for M-EVENT (_EventCalendar, specs/m-event-spec.md EV-8). Not part of PLStudies.csproj. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0642;CS0649;CS0169;CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Generated\**" />
    <Compile Include="..\..\_CmeSessionClock.Function.CS" Link="Linked\_CmeSessionClock.cs" />
  </ItemGroup>
  <Target Name="GenerateExtracted" BeforeTargets="BeforeBuild">
    <Exec Command="bash gen.sh" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <ItemGroup>
      <Compile Include="Generated\*.cs" />
    </ItemGroup>
  </Target>
</Project>
